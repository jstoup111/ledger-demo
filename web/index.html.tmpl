<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>ledger-demo</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main>
    <h1>ledger-demo</h1>

    <nav aria-label="Accounts">
      {{range .Accounts}}<a href="{{.Link}}">{{.Name}}</a>{{end}}
    </nav>

    <p class="balance">{{.Balance}}</p>

    <form method="post" action="{{.FormAction}}">
      <label>Amount <input name="amount" required></label>
      <label>Description <input name="description" required></label>
      <button type="submit">Post transaction</button>
    </form>

    <section aria-label="Transactions">
      {{if .Transactions}}
      <table>
        <thead><tr><th>Description</th><th>Amount</th></tr></thead>
        <tbody>
          {{range .Transactions}}<tr><td>{{.Description}}</td><td>{{.Amount}}</td></tr>{{end}}
        </tbody>
      </table>
      {{else}}
      <p>No transactions.</p>
      {{end}}
    </section>
  </main>
</body>
</html>
