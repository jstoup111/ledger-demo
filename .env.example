# =============================================================================
# SHARED INFRASTRUCTURE — none
# =============================================================================
# This project has no shared services. SQLite is a local file, not a server, so
# there is no database host, no port, no Redis, and no `docker compose up`.
# Multiple worktrees coexist by using a different PORT and a different
# LEDGER_DB_PATH — nothing is shared between them.

# =============================================================================
# WORKTREE-SPECIFIC — each worktree gets unique values
# =============================================================================
# Override in .env.local (gitignored) to avoid collisions between worktrees.

PORT=8080
LEDGER_DB_PATH=./ledger.db
WORKTREE_DB_SUFFIX=_main

# =============================================================================
# APPLICATION
# =============================================================================
# Deliberately empty. No secrets, no API keys, no external services — the demo
# makes zero network calls and must run fully offline.
